{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@my-task-timer/account-users-data-source": [
        "packages/account-users/data-source/src/index.ts"
      ],
      "@my-task-timer/account-users-domain": [
        "packages/account-users/domain/src/index.ts"
      ],
      "@my-task-timer/account-users-resource": [
        "packages/account-users/resource/src/index.ts"
      ],
      "@my-task-timer/shared-data-source": [
        "packages/shared/data-source/src/index.ts"
      ],
      "@my-task-timer/shared-interfaces": [
        "packages/shared/interfaces/src/index.ts"
      ],
      "@my-task-timer/shared-resource": [
        "packages/shared/resource/src/index.ts"
      ],
      "@my-task-timer/shared-utils-errors": [
        "packages/shared/utils/errors/src/index.ts"
      ],
      "@my-task-timer/shared-utils-interceptors": [
        "packages/shared/utils/interceptors/src/index.ts"
      ],
      "@my-task-timer/tasks-data-source": [
        "packages/tasks/data-source/src/index.ts"
      ],
      "@my-task-timer/tasks-domain": ["packages/tasks/domain/src/index.ts"],
      "@my-task-timer/tasks-feature": ["packages/tasks/feature/src/index.ts"],
      "@my-task-timer/tasks-resource": ["packages/tasks/resource/src/index.ts"],
      "@my-task-timer/tasks-ui": ["packages/tasks/ui/src/index.ts"],
      "@my-task-timer/time-log-data-source": [
        "packages/time-log/data-source/src/index.ts"
      ],
      "@my-task-timer/time-log-domain": [
        "packages/time-log/domain/src/index.ts"
      ],
      "@my-task-timer/time-log-resource": [
        "packages/time-log/resource/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
